---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../utils/posts';

const posts = await getAllPosts();

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="按标签浏览全部文章">
  <header class="max-w-2xl">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted">Tags</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">标签</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted">
      共 {tags.length} 个标签，按文章数量排序。
    </p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {tags.map(([tag, count]) => (
          <li>
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="flex items-center justify-between rounded-xl border border-line bg-surface px-5 py-4 transition hover:-translate-y-0.5 hover:border-accent/40"
            >
              <span class="font-medium">#{tag}</span>
              <span class="text-xs text-muted">{count} 篇</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-sm text-muted">还没有任何标签。</p>
    )
  }
</BaseLayout>
