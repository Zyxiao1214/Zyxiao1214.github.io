---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <div class="flex flex-col items-center py-24 text-center">
    <p class="text-sm font-medium uppercase tracking-[0.3em] text-accent">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">这一页不存在</h1>
    <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
      链接可能已经失效，或者我还没写这篇文章。
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition hover:opacity-90"
    >
      回到首页
    </a>
  </div>
</BaseLayout>
