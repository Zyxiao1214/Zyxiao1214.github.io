---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav aria-label="文章目录" class="text-sm">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.18em] text-muted">目录</p>
      <ul class="space-y-1 border-l border-line">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                'block border-l-2 border-transparent py-1 leading-snug text-muted transition-colors hover:text-ink',
                h.depth === 3 ? 'pl-6' : 'pl-3',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('.prose-blog h2[id], .prose-blog h3[id]'),
  );

  if (links.length > 0 && headings.length > 0) {
    const setActive = (id: string) => {
      for (const link of links) {
        const active = link.dataset.tocLink === id;
        link.style.borderLeftColor = active ? 'var(--color-accent)' : 'transparent';
        link.style.color = active ? 'var(--color-ink)' : '';
        link.classList.toggle('font-medium', active);
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive((visible[0].target as HTMLElement).id);
      },
      { rootMargin: '-88px 0px -65% 0px' },
    );

    headings.forEach((heading) => observer.observe(heading));
    setActive(headings[0].id);
  }
</script>
