---
import { NAV, SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-page/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.title} 首页`}>
      <span
        class="grid size-8 place-items-center rounded-lg bg-accent text-sm font-bold text-accent-ink shadow-sm"
      >
        {SITE.author.slice(0, 1).toUpperCase()}
      </span>
      <span class="text-sm font-semibold tracking-tight">{SITE.title}</span>
    </a>

    <nav class="flex items-center gap-0.5" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-accent-soft font-medium text-accent'
                : 'text-muted hover:bg-surface hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
